generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EvalRun {
  id                   String   @id @default(cuid())
  createdAt            DateTime @default(now())
  question             String
  groundTruth          String?
  sourceFilter         String?
  baselines            String[] @default(["gpt", "gemini"])
  ragAnswer            String
  ragAvgScore          Float
  ragTotalScore        Int
  gptAnswer            String?
  gptAvgScore          Float?
  gptTotalScore        Int?
  geminiAnswer         String?
  geminiAvgScore       Float?
  geminiTotalScore      Int?
  customAnswer         String?
  customAvgScore       Float?
  customTotalScore      Int?
  customScores         Json?
  ragAdvantageVsGpt    Float?
  ragAdvantageVsGemini Float?
  ragAdvantageVsCustom  Float?
  ragScores             Json
  gptScores             Json?
  geminiScores          Json?
  ragSources            Json
}

model ScrapedDocument {
  id                 Int         @id @default(autoincrement())
  source             String
  crawler            String
  title              String      @default("")
  date               String      @default("")
  department         String      @default("")
  link               String?     @unique
  details            String      @default("")
  content            String      @default("")
  circularNumber     String      @default("") @map("circular_number")
  pdfLinks           Json        @default("[]") @map("pdf_links")
  extra              Json        @default("{}")
  contentHash        String?     @map("content_hash")
  contentLength      Int?        @map("content_length")
  extractionAttempts Int?        @map("extraction_attempts")
  extractionError    String?     @map("extraction_error")
  extractionMethod   String?     @map("extraction_method")
  extractionStatus   String?     @map("extraction_status")
  extractionTimestamp DateTime? @map("extraction_timestamp") @db.Timestamptz(6)
  pdfCount           Int?        @map("pdf_count")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)

  affectedActs       String[]   @default([]) @map("affected_acts")
  severity          String?    @map("severity")
  deadlineDays      Int?       @map("deadline_days")
  releasedAt     DateTime?  @map("released_at") @db.Timestamptz(6)
  isLiveDrop     Boolean    @default(false) @map("is_live_drop")
  aiSummary       String?    @map("ai_summary")

  impactAnalyses  ImpactAnalysis[]
  complianceItems ComplianceItem[]
  draftComms      DraftComm[]

  @@map("scraped_documents")
  @@index([crawler])
  @@index([source])
}

model CircularAnalysis {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  title     String   @default("")
  inputMode String   @default("text") @map("input_mode")
  fileName  String?  @map("file_name")
  analysis  String

  @@map("circular_analyses")
}

model ExtractedObligation {
  id            Int       @id @default(autoincrement())
  docId         Int?      @map("doc_id")
  title         String    @default("")
  sourceUrl     String    @default("") @map("source_url")
  pdfLinks      Json      @default("[]") @map("pdf_links")
  chainType     String?   @map("chain_type")
  repealedBy    String?   @map("repealed_by")
  extraction    Json      @default("{}")
  modelUsed     String    @default("gpt-4o") @map("model_used")
  tokenCountIn  Int       @default(0) @map("token_count_in")
  tokenCountOut Int       @default(0) @map("token_count_out")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("extracted_obligations")
  @@index([docId])
  @@index([chainType])
}

model Client {
  id            String           @id @default(cuid())
  name          String
  sector        String
  turnoverCr    Float
  ownership     String
  city          String
  postureBadge  String           @default("LOW_RISK")
  createdAt     DateTime         @default(now())

  counterparties  Counterparty[]
  transactions    Transaction[]
  impactAnalyses  ImpactAnalysis[]
  complianceItems ComplianceItem[]
  draftComms      DraftComm[]

  @@map("demo_clients")
}

model Counterparty {
  id                String         @id @default(cuid())
  clientId          String
  name              String
  type              String
  concentrationPct  Float
  isFormallyRelated Boolean        @default(false)

  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions      Transaction[]

  @@index([clientId])
  @@map("demo_counterparties")
}

model Transaction {
  id             String       @id @default(cuid())
  clientId       String
  counterpartyId String
  invoiceNumber  String
  amount         Float
  date           DateTime
  type           String
  description    String       @default("")

  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([counterpartyId])
  @@map("demo_transactions")
}

model ImpactAnalysis {
  id             String          @id @default(cuid())
  circularId     Int
  clientId       String
  payload        Json
  lastComputedAt DateTime        @default(now())
  validatedAt    DateTime?

  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scrapedDocument ScrapedDocument @relation(fields: [circularId], references: [id], onDelete: Cascade)

  @@unique([circularId, clientId])
  @@index([circularId])
  @@map("demo_impact_analyses")
}

model ComplianceItem {
  id             String   @id @default(cuid())
  clientId       String
  circularId     Int?
  actName        String
  actionRequired String
  dueDate        DateTime
  status         String   @default("pending")
  severity       String   @default("medium")
  createdAt      DateTime @default(now())

  client            Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scrapedDocument ScrapedDocument? @relation(fields: [circularId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([dueDate])
  @@map("demo_compliance_items")
}

model DraftComm {
  id         String   @id @default(cuid())
  clientId   String
  circularId Int
  subject    String
  body       String
  channel    String   @default("email")
  status     String   @default("draft")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scrapedDocument ScrapedDocument @relation(fields: [circularId], references: [id], onDelete: Cascade)

  @@unique([circularId, clientId])
  @@index([clientId])
  @@map("demo_draft_comms")
}
